{
  "enabled": true,
  "debug": false,
  "size": 10,
  "blocksCols": 24,
  "placement": "beside-editor",
  "frame": true,
  "frameRows": 4,
  "minEditorWidth": 40,
  "readingSpeed": 4,
  "holdDuration": {
    "hi": 2400,
    "success": 1600,
    "failure": 2400,
    "bye": 6000
  },
  "blinkInterval": [3000, 6000],
  "talkTickMs": 120,
  "cycleMs": 500,
  "grandmaAfterMs": 30000,
  "accent": "auto",
  "emotes": [
    { "model": "*", "emote-set": "gentleman" }
  ],
  "terminals": [
    { "match": "zellij", "render": "ascii" },
    { "match": "tmux", "render": "auto" },
    { "match": "screen", "render": "ascii" },
    { "match": "wezterm", "render": "iterm2" },
    { "match": "ghostty", "render": "kitty" },
    { "match": "kitty", "render": "kitty" },
    { "match": "iterm2", "render": "iterm2" },
    { "match": "warpterminal", "render": "kitty" },
    { "match": "herdr", "render": "auto" },
    { "match": "alacritty", "render": "blocks" }
  ]
}
