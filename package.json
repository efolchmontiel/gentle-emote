{
  "name": "gentle-emote",
  "version": "0.1.4",
  "description": "Pixel-art Gentleman avatar that lives beside the Pi / Gentle Shell prompt and acts out what the agent is doing. Uses no tokens.",
  "license": "MIT",
  "type": "module",
  "author": "efolchmontiel",
  "homepage": "https://github.com/efolchmontiel/gentle-emote#readme",
  "bugs": {
    "url": "https://github.com/efolchmontiel/gentle-emote/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efolchmontiel/gentle-emote.git"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "sprites": "node scripts/sprites/build.ts",
    "scenes": "node scripts/sprites/scenes.ts",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "gentle-shell",
    "pixel-art",
    "emote",
    "avatar",
    "tui"
  ],
  "files": [
    "src",
    "emotes",
    "docs/avatar.png",
    "config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "image": "./docs/avatar.png",
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
